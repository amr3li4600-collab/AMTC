# Supabase PostgreSQL — Pooled connection (runtime, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL — Direct connection (Prisma CLI migrations, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Authentication
ADMIN_EMAIL="admin@amtc.ma"
ADMIN_PASSWORD="YourStrongAdminPasswordHere"
# Generate a random 64-char hex string: openssl rand -hex 32
ADMIN_SESSION_SECRET="generate-a-secure-random-32-byte-hex-string-for-jwt-signing"
